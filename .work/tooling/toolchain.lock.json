{
  "schema_version": 1,
  "kind": "toolchain-lock",
  "status": "DEV-ENV-001",
  "verified_on": "2026-11-12",
  "policy": "document -> pin -> smoke -> regression -> merge; no floating 'latest' pins; nothing here is a runtime dependency of the game",
  "install_root_default": ".tools",
  "tools": [
    {
      "id": "tool.python",
      "kind": "interpreter",
      "required": true,
      "phase": "now",
      "version": "3.13",
      "min_version": "3.11",
      "reason": "Design validators, unit tests, toolchain scripts; stdlib only",
      "install": "Install CPython from python.org (Windows) or the OS package manager; CI uses actions/setup-python",
      "integration_test": "python scripts/dev/doctor.py",
      "removal_plan": "Never a game runtime dependency; scripts stay stdlib-only",
      "ci_impact": "setup-python per job, no extra packages",
      "agent_compat": "any agent with a shell"
    },
    {
      "id": "tool.git",
      "kind": "vcs",
      "required": true,
      "phase": "now",
      "version": "2.40",
      "min_version": "2.40",
      "reason": "Branch/PR workflow from WORKFLOW.md",
      "install": "git-scm.com or OS package manager",
      "integration_test": "python scripts/dev/doctor.py",
      "removal_plan": "n/a",
      "ci_impact": "preinstalled on hosted runners",
      "agent_compat": "any agent with a shell"
    },
    {
      "id": "tool.gh",
      "kind": "cli",
      "required": false,
      "phase": "now",
      "version": "2.60",
      "min_version": "2.60",
      "reason": "Live verification of HEAD, PR, CI for CURRENT_STATE; PR creation and merge",
      "install": "cli.github.com; authenticate with 'gh auth login' (token never committed)",
      "integration_test": "python scripts/dev/doctor.py",
      "removal_plan": "GitHub web UI is an equivalent manual fallback",
      "ci_impact": "none (not used inside CI jobs)",
      "agent_compat": "any agent with a shell"
    },
