      "min_version": "9.7.1",
      "reason": "Godot unit/integration tests (s21 primary runner; gdUnit4 is the alternative, never both)",
      "install": "vendored into game/addons/gut at P0-00 from a pinned release commit",
      "integration_test": "intentionally failing GUT test must make CI exit non-zero",
      "removal_plan": "Switch to gdUnit4 only with an ADR",
      "ci_impact": "runs inside the Godot headless job after P0-00",
