# Stable text checkouts on Windows/Linux; avoids CRLF drift in provenance checks.
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.toml text eol=lf
*.godot text eol=lf
*.uid text eol=lf

# Reference images (ART-REF-001) live in Git LFS; CI validates pointers against ref/catalog.json.
ref/*.png filter=lfs diff=lfs merge=lfs -text
ref/*.jpg filter=lfs diff=lfs merge=lfs -text

# Generated ContentRegistry: digest is over exact bytes, never normalize (ADR-007).
game/content/generated/* -text

# Game sprites and their masters (ADR-009 section 5, ADR-013): binaries in Git LFS,
# manifest/source/prompt/cards and Godot .import files stay plain text.
game/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
art_source/**/*.webp filter=lfs diff=lfs merge=lfs -text
art_source/**/*.png filter=lfs diff=lfs merge=lfs -text
art_source/**/*.txt text eol=lf
*.import text eol=lf
